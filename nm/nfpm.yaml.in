# nfpm config for the veepin NetworkManager plugin package.
#
# Built via `make packages` (which exports VERSION, PKG_ARCH, MULTIARCH). This
# is a SEPARATE package from the CGO-free core: it carries a libnm/libgtk-3
# runtime dependency because of the GUI editor .so, so it must not be bundled
# with the static core binaries.
name: veepin-nm
arch: @PKG_ARCH@
platform: linux
version: @VERSION@
section: net
priority: optional
maintainer: Remy <21974988+xen0bit@users.noreply.github.com>
description: |
  NetworkManager VPN plugins for veepin.
  Adds one VPN type per veepin protocol — IKEv2, WireGuard, OpenVPN, SSTP, SSH,
  AnyConnect, Nebula, MASQUE, Fortinet and L2TP/IPsec — so each appears directly
  in the "Add VPN" list, backed by a shared D-Bus service that drives the veepin
  client plus a GTK editor per protocol. No dependency on strongSwan.
vendor: veepin
homepage: https://github.com/xen0bit/veepin
license: MIT

depends:
  - network-manager
  - libgtk-3-0

overrides:
  rpm:
    depends:
      - NetworkManager
      - gtk3
  apk:
    depends:
      - networkmanager
      - gtk+3.0

scripts:
  postinstall: scripts/postinstall.sh
  postremove: scripts/postremove.sh

# contents MUST stay the last key in this file: `make packages` appends one
# editor .so and one .name descriptor entry per protocol here, generated from the
# Makefile's VEEPIN_PROTOCOLS so the package tracks the list automatically.
contents:
  - src: bin/nm-veepin-service
    dst: /usr/lib/NetworkManager/nm-veepin-service
    file_info:
      mode: 0755
  - src: bin/nm-veepin-auth-dialog
    dst: /usr/lib/NetworkManager/nm-veepin-auth-dialog
    file_info:
      mode: 0755
  - src: data/nm-veepin-service.conf
    dst: /usr/share/dbus-1/system.d/nm-veepin-service.conf
    file_info:
      mode: 0644
